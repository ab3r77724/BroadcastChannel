---
import { Icon } from 'astro-icon/components'
import ChannelAvatar from './ChannelAvatar.astro'
import { getBooleanEnv, getEnv } from '../lib/env'
import { sanitizeContentHtml } from '../lib/sanitize'
import { buildSocialLinks } from '../lib/social'

const { SITE_URL, RSS_URL } = Astro.locals
const { channel } = Astro.props

const PODCAST = getEnv(import.meta.env, 'PODCAST')
const TWITTER = getEnv(import.meta.env, 'TWITTER')
const GITHUB = getEnv(import.meta.env, 'GITHUB')
const TELEGRAM = getEnv(import.meta.env, 'TELEGRAM')
const DISCORD = getEnv(import.meta.env, 'DISCORD')
const MASTODON = getEnv(import.meta.env, 'MASTODON')
const BLUESKY = getEnv(import.meta.env, 'BLUESKY')

const hideDescription = getBooleanEnv(import.meta.env, 'HIDE_DESCRIPTION')
const descriptionHtml = channel?.descriptionHTML ? sanitizeContentHtml(channel.descriptionHTML) : ''
const homeLabel = channel?.title ? `Home — ${channel.title}` : 'Home'

const socialLinks = buildSocialLinks({
  rssUrl: RSS_URL,
  podcast: PODCAST,
  twitter: TWITTER,
  github: GITHUB,
  telegram: TELEGRAM,
  discord: DISCORD,
  mastodon: MASTODON,
  bluesky: BLUESKY,
})
---

<header class="site-header">
  <a href={SITE_URL} class="avatar-link" title={channel?.title} aria-label={homeLabel}>
    <ChannelAvatar
      channel={channel}
      alt=""
      loading="eager"
      fetchpriority="high"
      width="48"
      height="48"
      class="channel-avatar"
    />
  </a>
  <a href={SITE_URL} class="title" title={channel?.title}>
    <h1>{channel?.title}</h1>
  </a>
  <div class="social-links" role="group" aria-label="Channel links">
    {
      socialLinks.map((item) => (
        <a href={item.href} title={item.title} target="_blank" rel={item.rel} type={item.type} aria-label={item.label}>
          <Icon name={item.icon} aria-hidden="true" />
        </a>
      ))
    }
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Toggle color theme"
      title="Toggle color theme"
    >
      <Icon class="theme-toggle-icon theme-toggle-icon-sun" name="ri:sun-line" aria-hidden="true" />
      <Icon class="theme-toggle-icon theme-toggle-icon-moon" name="ri:moon-line" aria-hidden="true" />
    </button>
  </div>
  {
    !hideDescription && descriptionHtml.length > 0 && (
      <div class="channel-description content" set:html={descriptionHtml} />
    )
  }
  <slot />
</header>

<script is:inline>
  ;(() => {
    const storageKey = 'bc-theme'
    const root = document.documentElement
    const meta = document.querySelector('meta[name="theme-color"]')
    const lightColor = '#ffffff'
    const darkColor = '#01242e'

    function readStoredTheme() {
      if (!('localStorage' in window)) {
        return null
      }

      const theme = window.localStorage.getItem(storageKey)
      return theme === 'light' || theme === 'dark' ? theme : null
    }

    function writeStoredTheme(theme) {
      if (!('localStorage' in window)) {
        return
      }

      window.localStorage.setItem(storageKey, theme)
    }

    function systemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }

    function currentTheme() {
      const attr = root.getAttribute('data-theme')
      if (attr === 'light' || attr === 'dark') {
        return attr
      }
      return systemTheme()
    }

    function syncToggle(theme) {
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const next = theme === 'dark' ? 'light' : 'dark'
        button.setAttribute('aria-label', `Switch to ${next} theme`)
        button.setAttribute('title', `Switch to ${next} theme`)
        button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false')
      })
    }

    function applyTheme(theme, persist) {
      if (theme !== 'light' && theme !== 'dark') {
        return
      }

      root.setAttribute('data-theme', theme)
      if (meta) {
        meta.setAttribute('content', theme === 'dark' ? darkColor : lightColor)
      }
      if (persist) {
        writeStoredTheme(theme)
      }
      syncToggle(theme)
    }

    applyTheme(currentTheme(), false)

    document.addEventListener('click', (event) => {
      const target = event.target
      const button = target instanceof Element ? target.closest('[data-theme-toggle]') : null
      if (!button) {
        return
      }
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', true)
    })

    const media = window.matchMedia('(prefers-color-scheme: dark)')
    const onChange = () => {
      if (readStoredTheme()) {
        return
      }
      applyTheme(systemTheme(), false)
    }

    if (typeof media.addEventListener === 'function') {
      media.addEventListener('change', onChange)
      return
    }

    if (typeof media.addListener === 'function') {
      media.addListener(onChange)
    }
  })()
</script>
