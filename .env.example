CHANNEL=miantiao_me

LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

TELEGRAM=miantiao_me
TWITTER=miantiao_me
GITHUB=miantiao-me
DISCORD=https://DISCORD.com
PODCAST=https://PODCAST.com
MASTODON=mastodon.social/@Mastodon
BLUESKY=bsky.app

FOOTER_INJECT=
# Base is always loaded. Optionally load one trusted-admin override; never combine themes.
# See THEMES.md for every built-in path, platform values, custom CSS, and security notes.
# HEADER_INJECT='<link rel="stylesheet" href="/themes/aria.css">'
HEADER_INJECT=

NOFOLLOW=false
NOINDEX=false
HIDE_DESCRIPTION=false

TELEGRAM_HOST=telegram.dog
STATIC_PROXY=""
# Optional Telegram Bot API access. Add the bot to the channel as an admin.
# - Empty: public channels are fetched from t.me previews; private channels fail.
# - Set: both public and private channels work; recent media is served at full
#   Telegram resolution through /api/bot-file instead of the ~800px web preview.
# - TELEGRAM_BOT_CHAT_ID is optional: set it when the bot manages more than one
#   channel, or leave empty to auto-detect when the bot only manages one channel.
# - Bot API history is limited to updates since the bot joined (~24h window),
#   so private channels only expose posts received by the bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_API_BASE="https://api.telegram.org"
TELEGRAM_BOT_CHAT_ID=""
# Adapter selection is automatic. EdgeOne is detected through std-env's edgeone_pages
# provider or platform-provided EDGEONE_PROJECT_ID/EO_MAKERS. Override only when needed.
SERVER_ADAPTER=""
# Append hostname-only proxy targets to the default whitelist, separated by commas.
TARGET_WHITELIST=""
GOOGLE_SEARCH_SITE=""
TAGS=""
COMMENTS=""
REACTIONS=""
LINKS=""
NAVS=""
RSS_BEAUTIFY=""
